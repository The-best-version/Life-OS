# --- بوت تيليجرام مستقل للنادي -------------------------------------------
# منفصل تماماً عن services/telegram-bot — توكن مختلف، محادثة قد تختلف،
# ملف .env مختلف. انسخ هذا إلى .env في نفس المجلد واملأ القيمتين الأولى
# والثانية:
#   copy .env.example .env
#
# .env مُستثنى في .gitignore ولا يُرفَع أبداً.
# ------------------------------------------------------------------------

# ١) التوكن — من @BotFather: /newbot ← اختر اسمًا ← ينسخ لك سطرًا بهذا الشكل.
TELEGRAM_GYM_BOT_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ٢) رقم محادثتك — البوت لا يردّ على غيره إطلاقًا.
#    أرسل أي رسالة للبوت، ثم شغّل: npm run whoami
TELEGRAM_GYM_CHAT_ID=0

# ٣) من أين يقرأ النادي ويكتبه. الافتراضي هو النسخة الأساسية.
LIFEOS_ORIGIN=http://127.0.0.1:47615

# ٤) الفحص اليومي الصامت — يرسل فقط حين يكون عنده ما يقوله فعلاً (ركود وزن،
#    حصص ناقصة). فارغ = مطفأ.
REMINDER_AT=20:30

# ٥) المراجعة الأسبوعية — يوم واحد، بخلاف الفحص اليومي تُرسَل دائماً ولو
#    كان الأسبوع فارغاً. اليوم: ٠=الأحد ... ٥=الجمعة ... ٦=السبت.
WEEKLY_REVIEW_AT=20:00
WEEKLY_REVIEW_DAY=5
