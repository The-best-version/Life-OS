# --- بوت تيليجرام لـ 2027 Life OS ---------------------------------------
# انسخ هذا الملف إلى .env في نفس المجلد، ثم املأ القيمتين الأولى والثانية.
#   copy .env.example .env
#
# .env مُستثنى في .gitignore ولا يُرفَع أبدًا. هذا الملف هو النسخة المرفوعة،
# وكل ما فيه قيم وهمية.
# ------------------------------------------------------------------------

# ١) التوكن — من @BotFather في تيليجرام:
#    /newbot ← اختر اسمًا ← ينسخ لك سطرًا بهذا الشكل.
#    هذا هو السر الوحيد هنا. من يملكه يملك البوت.
TELEGRAM_BOT_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ٢) رقم محادثتك — البوت لا يردّ على غيره إطلاقًا.
#    لمعرفته: أرسل أي رسالة للبوت، ثم شغّل:  npm run bot:whoami
TELEGRAM_CHAT_ID=0

# ٣) من أين يقرأ الحالة ويكتبها. الافتراضي هو النسخة الأساسية.
#    لا تغيّره إلا لتجربة البوت على نسخة مؤقتة:
#      node services/local-sync-server.js --port 47699 --data-dir life-os-test-data
#      LIFEOS_ORIGIN=http://127.0.0.1:47699
LIFEOS_ORIGIN=http://127.0.0.1:47615

# ٤) مواعيد الموجزين، بصيغة HH:MM بتوقيت هذا الجهاز.
#    موجز الصباح مربوط بالساعة لا بالفجر: الفجر في يونيو ٤:٠٠ صباحًا.
MORNING_AT=07:00
#    اتركه فارغًا ليأخذ نفس ساعة نافذة التقييم في التطبيق (٢٠:٠٠).
EVENING_AT=
