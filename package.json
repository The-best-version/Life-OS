{
  "name": "life-os-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "2027 Life OS وما يجاوره — التطبيق، خادم الحفظ المحلي، سكريبتات البناء والأتمتة.",
  "scripts": {
    "start": "node services/cloud-runner.mjs",
    "cloud": "node services/cloud-runner.mjs",
    "postinstall": "npm --prefix services/telegram-bot install",
    "dev": "node scripts/build-life-os.mjs && wscript \"services/launchers/run-life-os.vbs\"",
    "build": "node scripts/build-life-os.mjs",
    "build:watch": "node scripts/build-life-os.mjs --watch",
    "test": "node --test \"tests/*.test.mjs\"",
    "open": "wscript \"services/launchers/run-life-os.vbs\"",
    "serve": "node services/local-sync-server.js",
    "serve:test": "node services/local-sync-server.js --port 47699 --data-dir life-os-test-data",
    "bot": "node services/telegram-bot/bot.js",
    "bot:whoami": "node services/telegram-bot/whoami.js",
    "bot:install": "npm --prefix services/telegram-bot install",
    "report": "node services/report-agent.js",
    "report:watch": "node services/report-agent.js --watch"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "node-telegram-bot-api": "^2.1.0"
  }
}
