  "quotes": [
    {
      "id": "imqh6mw",
      "text": "أنت لا ترتقي إلى مستوى أهدافك، بل تهبط إلى مستوى أنظمتك.",
      "author": "جيمس كلير"
    },
    {
      "id": "wj9phve",
      "text": "إضاعة الوقت أشدّ من الموت؛ لأنها تقطعك عن الله والدار الآخرة.",
      "author": "ابن القيّم"
    },
    {
      "id": "2bd64ju",
      "text": "اقرأ ما تحبّ حتى تُحبّ القراءة.",
      "author": "نافال رافيكانت"
    },
    {
      "id": "bbqzah1",
      "text": "التركيز العميق مهارة نادرة وثمينة في اقتصاد اليوم.",
      "author": "كال نيوبورت"
    },
    {
      "id": "ngy2yfo",
      "text": "حاسبوا أنفسكم قبل أن تُحاسَبوا.",
      "author": "عمر بن الخطاب"
    },
    {
      "id": "880630w",
      "text": "ابن آدم، إنما أنت أيام؛ فإذا ذهب يوم ذهب بعضك.",
      "author": "الحسن البصري"
    },
    {
      "id": "fqqw0l4",
      "text": "ومن لم يذق مرّ التعلّم ساعة، تجرّع ذلّ الجهل طول حياته.",
      "author": "الإمام الشافعي"
    },
    {
      "id": "b0oglxc",
      "text": "ليست حياتنا قصيرة، بل نحن نُضيّع كثيرًا منها.",
      "author": "سينيكا"
    },
    {
      "id": "2fi6siu",
      "text": "أنت تملك سلطانًا على عقلك، لا على الأحداث. أدرك هذا تجد القوة.",
      "author": "ماركوس أوريليوس"
    },
    {
      "id": "v3d63cu",
      "text": "وقتك محدود، فلا تُضيّعه عيشًا في حياة شخص آخر.",
      "author": "ستيف جوبز"
    },
    {
      "id": "ddicnpx",
      "text": "الناجحون جدًّا يقولون «لا» لكل شيء تقريبًا.",
      "author": "وارن بافيت"
    },
    {
      "id": "33xvld7",
      "text": "ما يُقاس، يتحسّن.",
      "author": "بيتر دراكر"
    },
    {
      "id": "kl8we5k",
      "text": "ما يصنع أعدائي بي؟ أنا جنّتي وبستاني في صدري.",
      "author": "ابن تيمية"
    },
    {
      "id": "s99ufm6",
      "text": "العادة هي الفائدة المركّبة لتطوير الذات.",
      "author": "جيمس كلير"
    },
    {
      "id": "g0roear",
      "text": "من عرف طول الطريق استعدّ له، ومن أيقن بالمنزل هان عليه السفر.",
      "author": "ابن القيّم"
    },
    {
      "id": "dmyce7q",
      "text": "لا تُصلح عملك لأجل الناس، ولا تُفسده لأجلهم.",
      "author": "الفضيل بن عياض"
    },
    {
      "id": "34i01jz",
      "text": "الانضباط هو اختيار ما تريده أكثر على ما تريده الآن.",
      "author": "أبراهام لينكون"
    },
    {
      "id": "i6qqwqr",
      "text": "أصعب خطوة هي الأولى؛ وما بعدها عادة.",
      "author": "أرسطو"
    },
    {
      "id": "fbhnqgk",
      "text": "إذا لم تكن لك خطة، فستكون جزءًا من خطة غيرك.",
      "author": "تيري ماكميلان"
    },
    {
      "id": "b6vzd4k",
      "text": "عش يومك كأنه آخر أيامك، واعمل كأنك تعيش أبدًا.",
      "author": "مثل عربي"
    },
    {
      "id": "8gviu2p",
      "text": "النجاح مجموع جهود صغيرة تتكرّر يومًا بعد يوم.",
      "author": "روبرت كوليير"
    },
    {
      "id": "61zrl3h",
      "text": "أفضل وقت لغرس شجرة كان قبل عشرين عامًا، وثانيه اليوم.",
      "author": "مثل صيني"
    },
    {
      "id": "kjjptbw",
      "text": "لن تتغيّر حياتك حتى تتغيّر عاداتك اليومية؛ السرّ في جدولك.",
      "author": "جون مكسويل"
    },
    {
      "id": "z3jedxe",
      "text": "من استوى يوماه فهو مغبون، ومن كان غده شرًّا من يومه فهو ملعون.",
      "author": "الحسن البصري"
    },
    {
      "id": "dzihent",
      "text": "التركيز يعني قول «لا» لمئة فكرة جيّدة.",
      "author": "ستيف جوبز"
    },
    {
      "id": "pdnyw94",
      "text": "لا يُدرَك العلم براحة الجسم، ولا تُنال المعالي بالتمنّي.",
      "author": "الإمام مسلم"
    },
    {
      "id": "cfxeioi",
      "text": "أنت ما تفعله بتكرار؛ فالتميّز ليس حدثًا بل عادة.",
      "author": "ويل ديورانت"
    },
    {
      "id": "g2haelb",
      "text": "أعظم ما يملكه المرء وقتٌ فارغ يملؤه بما ينفع.",
      "author": "ابن الجوزي"
    },
    {
      "id": "hlw7suj",
      "text": "لا تنتظر الإلهام؛ اذهب إليه بعصا غليظة.",
      "author": "جاك لندن"
    },
    {
      "id": "wx3yk0c",
      "text": "ما بدأتَه اليوم يصنع من تكون بعد سنة.",
      "author": "سينيكا"
    }
  ],
  "reads": [
    {
      "id": "8dnthyp",
      "text": "الكتاب بلا درس مكتوب لم يُقرأ، بل مُرّ عليه.",
      "author": "قاعدة المكتبة"
    },
    {
      "id": "v1s5774",
      "text": "من قرأ كتابًا واحدًا وطبّقه، أنفع ممن قرأ مئة ونسيها.",
      "author": "مثل مأثور"
    },
    {
      "id": "dxu12nl",
      "text": "اقرأ ما تحبّ حتى تُحبّ القراءة.",
      "author": "نافال رافيكانت"
    },
    {
      "id": "xfafz2w",
      "text": "لو لم يكن في الكتب إلا أنها تقطع عنك وساوس الفراغ لكفى.",
      "author": "ابن الجوزي"
    },
    {
      "id": "zq6fbvm",
      "text": "الكتب هي المرآة التي نرى فيها أنفسنا قبل أن نرى غيرنا.",
      "author": "عباس العقاد"
    },
    {
      "id": "ky3f434",
      "text": "قراءة عشر صفحات كل يوم تصنع ١٥ كتابًا في السنة. البطء ليس العدوّ، الانقطاع هو.",
      "author": "قاعدة التراكم"
    },
    {
      "id": "172wmbf",
      "text": "خير جليس في الزمان كتاب.",
      "author": "المتنبّي"
    },
    {
      "id": "cu8nxkz",
      "text": "لا تقرأ لتردّ، ولا لتصدّق؛ اقرأ لتزن وتفكّر.",
      "author": "فرانسيس بيكون"
    },
    {
      "id": "k8andu3",
      "text": "الفصل الذي لم تلخّصه، ستنساه قبل نهاية الشهر.",
      "author": "قاعدة التلخيص"
    },
    {
      "id": "0n7r3ae",
      "text": "قيمة الكتاب في ما غيّره فيك، لا في عدد صفحاته.",
      "author": "قاعدة المكتبة"
    },
    {
      "id": "ichoiif",
      "text": "من لم يذق مرّ التعلّم ساعة، تجرّع ذلّ الجهل طول حياته.",
      "author": "الإمام الشافعي"
    },
    {
      "id": "s7rj05g",
      "text": "كتاب تقرؤه مرّتين خير من كتابين تقرأ كلًّا منهما مرّة.",
      "author": "قاعدة العمق"
    }
  ],
