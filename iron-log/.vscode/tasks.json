{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 تشغيل تطبيق النادي (npm run dev)",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Starting.*",
          "endsPattern": ".*Ready in.*|.*Local:.*http://localhost:3000.*"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "🔍 فحص الأنواع والأخطاء (npm run typecheck)",
      "type": "shell",
      "command": "npm run typecheck",
      "group": "test",
      "problemMatcher": "$tsc",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "🏗️ بناء التطبيق (npm run build)",
      "type": "shell",
      "command": "npm run build",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "📦 بناء ملف واحد (npm run build:standalone)",
      "type": "shell",
      "command": "npm run build:standalone",
      "group": "build",
      "problemMatcher": [],
      "detail": "الناتج standalone/index.html — ما يفتحه اختصار «افتح Iron Log» على سطح المكتب. لازم إعادة بناء بعد أي تعديل على src/."
    }
  ]
}
